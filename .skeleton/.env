# ------------------------------------------------------------------------------
# Container version overrides. Update these values and restart your containers
# (i.e. 'docker compose up -d') to update your installation.
# ------------------------------------------------------------------------------

# FRIGATE_VERSION=latest

# ------------------------------------------------------------------------------
# Container port mapping overrides.
# ------------------------------------------------------------------------------

# AUTH_PORT=8971
# WEBRTC_PORT=8555

# ------------------------------------------------------------------------------
# Define the paths to your media (e.g. clips, recordings and exports) directory.
# This may be absolute or relative to the 'docker-compose.yaml' file.
# ------------------------------------------------------------------------------

MEDIA_PATH=

# ------------------------------------------------------------------------------
# Hardware acceleration configuration. Defaults to 'cpu' when left unset.
# Options: 'cpu', 'amd', 'intel', 'nvidia', 'coral-usb' or 'coral-pcie'
# ------------------------------------------------------------------------------

# HARDWARE_ACCELERATION=cpu

# ------------------------------------------------------------------------------
# TMPFS cache size in bytes (1GB by default). Helps to reduce SSD/SD card wear. 
# ------------------------------------------------------------------------------

# TMPFS_CACHE_SIZE=1000000000

# ------------------------------------------------------------------------------
# Docker shared memory size. Used for storing frames during processing. For more
# information or to calculate the necessary shm-size see the Frigate docs.
#
# https://docs.frigate.video/frigate/installation/#calculating-required-shm-size
# ------------------------------------------------------------------------------

# SHM_SIZE=64mb
